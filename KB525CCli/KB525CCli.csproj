<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>kb525c</AssemblyName>
    <RootNamespace>KB525CCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.6.0</Version>

    <Product>KB525C Control</Product>
    <Description>Command-line client of KB525C Control: LED signals, status and control of the tray app over its named pipe.</Description>
    <Authors>András Bükki-Deme</Authors>
    <Company>Hollovar Labs</Company>
    <Copyright>Copyright © 2026 András Bükki-Deme</Copyright>
    <RepositoryUrl>https://github.com/hollovar/KB525CControl</RepositoryUrl>
    <PackageProjectUrl>https://hollovar.github.io/kb525c/</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- A protokoll es a kliens a talcaalkalmazasbol jon, hogy egy helyen legyen definialva. -->
  <ItemGroup>
    <Compile Include="..\KB525CControl\Ipc\PipeProtocol.cs" Link="Ipc\PipeProtocol.cs" />
    <Compile Include="..\KB525CControl\Ipc\PipeClient.cs" Link="Ipc\PipeClient.cs" />
  </ItemGroup>

</Project>
